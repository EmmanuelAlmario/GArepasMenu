# URLs para DESARROLLO local.
# En produccion no se usan: el contenedor las inyecta en runtime con las
# variables de entorno API_URL y WHATSAPP_URL (ver Dockerfile / README).
# WHATSAPP_URL: numero con codigo de pais (ej. https://wa.me/573001234567).
# Si queda vacio, los botones de pedido se ocultan solos.
VITE_API_URL=http://localhost:8080
VITE_WHATSAPP_URL=
